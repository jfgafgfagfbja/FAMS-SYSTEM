# Cau hinh build/chay app Flutter. Chep thanh .env roi dung:
#   flutter run -d chrome --web-port 5274 --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
# (Gia tri o day duoc dong goi vao app luc build - KHONG dat bi mat nao vao day.)

# Dia chi MAY CHU (khong kem /api/v1 - client tu ghep). De trong:
#   - ban web: cung origin voi trang web (nginx chuyen /api/ sang server)
#   - Android emulator: http://10.0.2.2:8100 ; iOS simulator/desktop: http://localhost:8100
# Nguoi dung van doi duoc dia chi may chu o man hinh dang nhap (bieu tuong may chu).
API_BASE_URL=http://localhost:8100
